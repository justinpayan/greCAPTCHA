DATABASE_URL=./data/public-grecaptcha.db
# Required. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this stable: changing it makes stored OpenRouter keys unreadable.
ACCOUNT_ENCRYPTION_KEY=
# Optional separate salt for irreversible rate-limit identifiers.
RATE_LIMIT_SALT=
# Public origin participants reach, e.g. https://rc.example.org
# Used to build participant links; falls back to the browser's own origin.
PUBLIC_BASE_URL=
JOB_CONCURRENCY=2
MAX_SETS_PER_ACCOUNT=100
MAX_ATTEMPTS_PER_ACCOUNT=500

# Where backups are written. Leave unset to switch backups off entirely.
# On Railway, keep this under the /app/data volume.
BACKUP_DIR=./data/backups
# How often a backup is taken, in minutes. Default 60.
BACKUP_INTERVAL_MINUTES=60
# How many backups to keep. The oldest beyond this are deleted. Default 48.
BACKUP_KEEP=48
