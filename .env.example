DATABASE_URL=./data/public-grecaptcha.db
# 32 random bytes encoded as base64. Required in production to encrypt the complete SQLite
# database, manuscripts, active job uploads, and app-created backups.
# Generate once with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Production defaults to true. This example opts out for disposable local development data.
DATA_ENCRYPTION_REQUIRED=false
# Recommended in production: a stable random salt for irreversible rate-limit identifiers.
RATE_LIMIT_SALT=
# Public origin participants reach, e.g. https://rc.example.org
# Used to build participant links; falls back to the browser's own origin.
PUBLIC_BASE_URL=
JOB_CONCURRENCY=2
MAX_SETS_PER_ACCOUNT=100
MAX_ATTEMPTS_PER_ACCOUNT=500
# 32 random bytes encoded as base64. Required to encrypt professor OAuth credentials.
# Generate once (for example: openssl rand -base64 32) and keep it stable across deploys.
OPENROUTER_CREDENTIAL_ENCRYPTION_KEY=

# Optional institution model endpoints, such as a university's LiteLLM gateway. Users listed in a
# group may choose between OpenRouter and their group's endpoint; everyone else uses OpenRouter.
# Users never see the address. JSON object keyed by group ID (lowercase letters, digits, hyphens):
#   {"cmu": {"label": "CMU", "baseUrl": "https://litellm.example.edu", "users": ["instructor-a"]}}
# Per group: "kind" is "litellm" (default; give the proxy's root URL) or "openai" (any other
# OpenAI-compatible server; give the URL up to /v1). An optional "catalogKey" reads the model list.
# Tests on an institution endpoint are paid for by their creator's stored key, never by takers.
# Changes apply on restart and affect new tests only; a malformed value stops the server at start.
LLM_ENDPOINTS=
# Or the same JSON in a file, for long user lists (set one or the other, not both).
LLM_ENDPOINTS_FILE=

# Where backups are written. Leave unset to switch backups off entirely.
# On Railway, keep this under the /app/data volume.
BACKUP_DIR=./data/backups
# How often a backup is taken, in minutes. Default 60.
BACKUP_INTERVAL_MINUTES=60
# How many backups to keep. The oldest beyond this are deleted. Default 48.
BACKUP_KEEP=48

# Self-hosted GitLab instances whose repositories may be linked as codebases, in addition to
# github.com and gitlab.com. Comma-separated host names, e.g. gitlab.cs.example.edu. Each must be
# reachable on a public address: links to private-network addresses are always refused.
CODE_GITLAB_HOSTS=
